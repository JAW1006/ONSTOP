# TimeStay API 프록시(server/server.js) 환경변수
# 이 파일을 server/.env로 복사해서 값을 채운다:  cp .env.example .env
# server/.env는 server/.gitignore로 커밋되지 않는다. 실제 키를 이 파일(.env.example)에 넣지 말 것.
# Render 배포: render.yaml에 같은 이름으로 선언돼 있고(sync: false), 값은 Render 대시보드에서 넣는다.
# 전체 표: docs/api/environment.md

# ─────────────────────────────────────────────────────────────
# AIRPORT_SERVICE_KEY — 필수(항공편 조회·출국장 대기시간)
#   용도: 인천국제공항공사 API 인증키
#     - 여객편 운항현황(다국어)  → /api/flight/arrival, /api/flight/departure
#     - 출국장 혼잡도 조회       → /api/security-wait (T1 실시간 대기시간)
#     - 출국장 혼잡도_제2여객터미널 → /api/security-wait/t2 (T2 실시간 대기시간, 별도 활용신청)
#   발급처: 공공데이터포털 data.go.kr > 각 API "활용신청" > 마이페이지 > 활용신청 현황 > 일반 인증키
#   형식: Encoding/Decoding 키 어느 쪽이든 가능(서버가 decodeURIComponent로 정규화)
#   없으면: 서버는 경고만 출력하고 뜨지만 위 엔드포인트가 500 → 앱은 데모 도착 시각(10:30)·고정 수속 50분으로 동작
AIRPORT_SERVICE_KEY=

# ─────────────────────────────────────────────────────────────
# KAKAO_REST_API_KEY — 필수(실제 이동시간·지도 주변 장소)
#   용도: 카카오 REST API 키(서버 전용, 비밀)
#     - 카카오모빌리티 길찾기(자동차)        → /api/route
#     - 카카오 로컬 카테고리·키워드 검색      → /api/places, /api/places/search
#   발급처: Kakao Developers developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키
#     제품 설정에서 "카카오모빌리티"와 "카카오맵"(로컬 검색 포함)을 활성화해야 한다
#     카카오맵이 꺼져 있으면 /api/places*가 "disabled OPEN_MAP_AND_LOCAL service"로 실패한다
#   없으면: 위 엔드포인트가 500 → 앱은 데이터의 더미 이동시간으로 계산, 주변 실제 가게는 안 뜸
#   주의: 프런트엔드 app/index.html의 카카오맵 "JavaScript 키"와는 다른 키다(그쪽은 공개용)
KAKAO_REST_API_KEY=

# ─────────────────────────────────────────────────────────────
# ODSAY_API_KEY — 선택(대중교통 이동시간)
#   용도: ODsay 대중교통 경로 검색 → /api/transit (직선 6km 이상 구간)
#   발급처: ODsay Lab lab.odsay.com > 회원가입 > API 신청
#   없으면: /api/transit가 500 → 앱이 조용히 자동차(카카오모빌리티) 이동시간으로 대체
ODSAY_API_KEY=

# ─────────────────────────────────────────────────────────────
# PORT — 선택(기본 3001)
#   용도: Express 서버 포트. 같은 서버가 app/ 정적 파일도 서빙한다(카카오맵 도메인 등록: http://localhost:3001)
#   Render는 PORT를 자동으로 주입하므로 배포 환경에서는 설정하지 않는다
#   React 개발 서버(vite.config.ts)의 /api 프록시가 http://localhost:3001을 가리키므로 바꾸면 그쪽도 맞춰야 한다
PORT=3001
