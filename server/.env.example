# data.go.kr 마이페이지 > 활용신청 현황에서 "일반 인증키(Decoding)" 값을 사용하세요.
# (Encoding 키를 넣으면 URLSearchParams가 다시 인코딩해서 이중 인코딩 오류가 납니다.)
AIRPORT_SERVICE_KEY=

# Kakao Developers(developers.kakao.com) > 내 애플리케이션 > 앱 생성 > 제품 설정에서
# "카카오모빌리티"를 활성화한 뒤, 앱 키 탭의 REST API 키를 그대로 사용하세요.
KAKAO_REST_API_KEY=

# ODsay Lab(lab.odsay.com) 회원가입 > API 신청에서 발급받은 키를 사용하세요. (대중교통 경로 검색)
# 비워두면 대중교통 조회가 자동으로 자동차(카카오모빌리티) 값으로 대체됩니다.
ODSAY_API_KEY=

PORT=3001
